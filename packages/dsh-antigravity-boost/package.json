{
  "name": "dsh-antigravity-boost",
  "version": "0.1.2",
  "description": "Antigravity /boost-style deep reasoning for DeepSeek Harness: ephemeral isolated worktrees, parallel implementation + investigation workstreams, local verification, and a failure-feedback iteration loop.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./worktree": "./lib/worktree.js",
    "./verify": "./lib/verify.js",
    "./pipeline": "./lib/pipeline.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/worktree.js && node --check lib/verify.js && node --check lib/pipeline.js",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "boost",
    "worktree",
    "deep-reasoning",
    "antigravity",
    "verification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuediner-source/dsh-plugin-suite.git",
    "directory": "packages/dsh-antigravity-boost"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/xuediner-source/dsh-plugin-suite/issues"
  },
  "homepage": "https://github.com/xuediner-source/dsh-plugin-suite/tree/main/packages/dsh-antigravity-boost#readme"
}
