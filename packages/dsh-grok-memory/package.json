{
  "name": "dsh-grok-memory",
  "version": "0.3.1",
  "description": "Five-track cross-session memory for DeepSeek Harness: injected global/user/key facts plus on-demand project/daily logs, first-turn injection so new conversations share prior project memory, SQLite FTS5 search, /remember /flush /dream, and a user-confirmation queue for injected facts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tracks": "./lib/tracks.js",
    "./search": "./lib/search.js",
    "./dream": "./lib/dream.js",
    "./inject": "./lib/inject.js",
    "./suggest": "./lib/suggest.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/tracks.js && node --check lib/search.js && node --check lib/dream.js && node --check lib/inject.js && node --check lib/suggest.js",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "migrate": "node scripts/migrate-v0.2.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "memory",
    "cross-session",
    "grok",
    "dream",
    "five-track"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuediner-source/dsh-plugin-suite.git",
    "directory": "packages/dsh-grok-memory"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/xuediner-source/dsh-plugin-suite/issues"
  },
  "homepage": "https://github.com/xuediner-source/dsh-plugin-suite/tree/main/packages/dsh-grok-memory#readme"
}
